# BondCircle Environment Configuration
# 
# Copy this file to .env and customize for your environment.
# Do NOT commit actual credentials to Git.

# Application Profile
# Set the active Spring profile: local (H2), dev (MySQL), test, or prod
SPRING_PROFILES_ACTIVE=local

# Server Port
SERVER_PORT=8080

# Database Configuration
# MySQL production configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dating_chat_db
DB_USERNAME=chat_user
DB_PASSWORD=your_secure_password_here

# H2 Local Development (when SPRING_PROFILES_ACTIVE=local)
# H2 console available at: http://localhost:8080/h2-console
# JDBC URL: jdbc:h2:mem:dating_chat_local;MODE=MySQL

# JWT Configuration
# The JWT secret is read from application.properties/yaml via @Value
# Do not change this unless you update the backend as well
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_ISSUER=dating-app-auth-service
JWT_EXPIRATION=86400000

# Frontend Configuration (same-origin since frontend is in Spring Boot)
# No need to configure these for same-origin deployment
# API_BASE_URL and WS_BASE_URL are derived from window.location in the frontend

# WebSocket Configuration
# WebSocket endpoint is /ws (SockJS + STOMP)
# For production WSS, ensure backend WebSocketConfig allows your domain

# Development: Test Authentication
# When enabled, allows login with User IDs 101, 202, 303
BOND_CIRCLE_TEST_AUTH_ENABLED=true

# Logging
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_COM_DATINGAPP_CHAT=DEBUG
