FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build
COPY pom.xml .
RUN mvn -B dependency:go-offline
COPY src ./src
RUN mvn -B -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /build/target/chat-service-1.0.0-SNAPSHOT.jar /app/chat-service.jar
ENV SPRING_PROFILES_ACTIVE=prod,vercel
ENV PORT=8080
EXPOSE 8080
USER 10001:10001
ENTRYPOINT ["java", "-Duser.timezone=UTC", "-jar", "/app/chat-service.jar"]
